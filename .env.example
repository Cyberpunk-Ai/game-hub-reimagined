# ---------------------------------------------------------------------------
# Site / branding (client-visible)
# ---------------------------------------------------------------------------
VITE_APP_NAME="GameFlex"
VITE_APP_DESCRIPTION="The world's premier gaming ecosystem."
VITE_SITE_URL="https://gameflex.app"
VITE_CURRENCY="KES"
VITE_SUPPORT_EMAIL="support@gameflex.app"
# Default players per tournament lobby; extra players overflow into Lobby #2, #3 ...
VITE_DEFAULT_LOBBY_SIZE="16"

# ---------------------------------------------------------------------------
# Backend provider selection (see docs/backend-providers.md)
# Each capability can point at a different provider.
# ---------------------------------------------------------------------------
# supabase | rest
VITE_BACKEND_PROVIDER="supabase"
# supabase | custom
VITE_AUTH_PROVIDER="supabase"
# supabase | s3 | r2 | vps
VITE_STORAGE_PROVIDER="supabase"
# supabase | none
VITE_REALTIME_PROVIDER="supabase"

# PostgREST-compatible data API (VITE_BACKEND_PROVIDER=rest)
VITE_BACKEND_REST_URL=""
VITE_BACKEND_REST_KEY=""

# Auth gateway (VITE_AUTH_PROVIDER=custom)
VITE_AUTH_API_URL=""

# Object storage gateway (VITE_STORAGE_PROVIDER=s3|r2|vps)
VITE_STORAGE_API_URL=""
VITE_STORAGE_PUBLIC_URL=""

# ---------------------------------------------------------------------------
# Supabase credentials (self-hosted or supabase.com — swap freely)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# Server-only mirrors (never exposed to the browser)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_PROJECT_ID=""

# ---------------------------------------------------------------------------
# Social sign-in (comma separated: google,apple,github,discord,azure)
# Providers must also be enabled in your auth backend.
# ---------------------------------------------------------------------------
VITE_OAUTH_PROVIDERS="google"

# ---------------------------------------------------------------------------
# Observability (optional) — any endpoint that accepts a JSON POST
# e.g. a Sentry tunnel, Logflare, or your own collector.
# ---------------------------------------------------------------------------
VITE_ERROR_REPORTING_URL=""
